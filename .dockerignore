# Host node_modules must never reach the image: the Dockerfile runs `npm ci`
# before `COPY . .`, so copying host modules would overwrite the Linux-built
# ones with whatever your machine produced (Windows/macOS binaries) and break
# every run.
node_modules

# Never bake secrets into an image layer. `.env.example` is kept on purpose.
.env
.env.*
!.env.example

# Test and report output — regenerated inside the container anyway.
test-results/
playwright-report/
blob-report/
allure-results/
allure-report/
allure-temp/
playwright/.auth/
playwright/.cache/

# Not needed to run tests.
#
# NOTE: excluding `.github` and `docs` means `npm run format:check` and
# `npm run lint` inside the container do NOT see the workflow YAML or the
# markdown under docs/, and so pass vacuously on them. Treat lint and format as
# HOST or CI gates, not container gates. Re-including them would rebuild the
# `COPY . .` layer on every documentation edit, which is the worse trade.
.git
.gitignore
.github
.devcontainer
docs
*.log

# Git hooks: the image has no .git, so they can never run there.
.husky

# Editor/OS noise.
.idea
.vscode
.DS_Store

# Local planning/scratch directory (git-ignored).
.superpowers
