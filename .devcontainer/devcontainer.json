{
  "name": "Playwright Template",
  "image": "mcr.microsoft.com/playwright:v1.62.1-noble",
  "runArgs": ["--ipc=host"],
  "workspaceFolder": "/workspaces/playwright-template",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/playwright-template,type=bind",
  "mounts": ["source=playwright-template-node-modules,target=/workspaces/playwright-template/node_modules,type=volume"],
  "postCreateCommand": "sudo chown -R $(id -u):$(id -g) node_modules && npm ci",
  "customizations": {
    "vscode": {
      "extensions": ["ms-playwright.playwright", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "playwright.reuseBrowser": true
      }
    }
  },
  "forwardPorts": [4173]
}
